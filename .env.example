# obra.com.py - example environment. Copy the names you need to your server
# environment (or to config/local.php); never commit real values. Do not commit
# .env, config/local.php, private/vendercrm.php or anything under storage/.
#
# PRECEDENCE
# CRM pair (endpoint + key), highest first:
#   1. environment: VENDERCRM_URL + VENDERCRM_API_KEY
#   2. private/vendercrm.php, one level above the document root
#      (or the absolute path in VENDERCRM_CONFIG_FILE)
#   3. config/local.php crm_endpoint / crm_api_key (legacy fallback)
#   4. defaults in config/site.php (OBRA_CRM_ENDPOINT / OBRA_CRM_API_KEY)
#   A canonical source (1 or 2) fully replaces 3 and 4. Partial pairs or
#   conflicting 1 vs 2 values are rejected and the CRM is disabled.
# All other OBRA_* values, highest first:
#   1. config/local.php, when present and OBRA_LOCAL_CONFIG is not 0
#   2. environment
#   3. defaults in config/site.php
# Note: a variable that is set but empty counts as set (it replaces the
# default with an empty value). If your loader exports empty values, delete
# the line instead of leaving it blank, e.g. OBRA_WHATSAPP to use the default.

# --- Site identity ---
OBRA_DOMAIN=obra.com.py
OBRA_ORIGIN=https://obra.com.py
# Digits only. Do not set it (or leave it out of the server environment)
# to use the default in config/site.php.
OBRA_WHATSAPP=
OBRA_EMAIL=

# --- Legal / privacy ---
OBRA_LEGAL_OPERATOR=
OBRA_RUC=
OBRA_LEGAL_ADDRESS=
# Falls back to OBRA_EMAIL when empty.
OBRA_PRIVACY_EMAIL=

# --- Service area ---
OBRA_AREA=Asunción y Gran Asunción
OBRA_TERRITORY=Paraguay
# City of the legal address (schema addressLocality).
OBRA_LOCALITY=Asunción

# --- Measurement ---
OBRA_ANALYTICS_ID=
# Google Ads account id (AW-...) and conversion labels. Empty = no tag.
OBRA_ADS_ID=
OBRA_ADS_LABEL_WA=
OBRA_ADS_LABEL_FORM=
OBRA_ADS_LABEL_TEL=
# 16+ characters, typed into the /stats.php login form. Empty = the page does not exist.
OBRA_STATS_TOKEN=

# --- Runtime ---
# Directory for event logs. Empty = ./storage (blocked by .htaccess).
OBRA_STORAGE=
# Set to 0 to ignore config/local.php (used by tools/verify).
OBRA_LOCAL_CONFIG=1

# --- VenderCRM (server only, preferred) ---
# HTTPS base origin only, no API path.
VENDERCRM_URL=https://crm.clientes.com.py
VENDERCRM_API_KEY=
# Optional absolute path to the private file, outside the document root.
VENDERCRM_CONFIG_FILE=

# --- VenderCRM legacy fallback (only used when no canonical source is set) ---
OBRA_CRM_ENDPOINT=https://crm.clientes.com.py/api/v1/leads
OBRA_CRM_API_KEY=

# --- Local tests only (never set on a server) ---
# OBRA_CRM_MOCK=success   # or any other value to simulate a failure
